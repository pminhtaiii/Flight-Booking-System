# Shared JWT secret used by NestJS to sign standard HS256 tokens
JWT_SECRET=test_secret

# API key for identifying agent service requests to backend
AGENT_SERVICE_API_KEY=mock_agent_key

# Secret key used for signing outgoing agent user claims
CLAIM_TOKEN_SECRET=mock_claim_secret

# Next.js frontend origin for CORS
FRONTEND_URL=http://127.0.0.1:3000

# NestJS API base URL
NESTJS_API_URL=http://127.0.0.1:3001/api

# Mimo OpenAI-compatible endpoint
MIMO_API_URL=http://127.0.0.1:3002

# Mimo API key
MIMO_API_KEY=test_key

# Model identifier
MIMO_MODEL_NAME=mimo

# Enable LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=flight-booking-chatbot

# Agent service port
AGENT_PORT=3002

# Constraints & Limits
MAX_MESSAGE_LENGTH=10000
MEMORY_WINDOW_SIZE=20
MEMORY_TOKEN_BUDGET=4000
QUEUE_MAX_DEPTH=3

# Redis and Quota Settings
REDIS_URL=redis://localhost:6379/0
CHAT_QUOTA_DAILY=50
CHAT_QUOTA_BURST=60

# Router Settings
ROUTER_CONFIDENCE_THRESHOLD=0.7

# Snapshot Settings
SNAPSHOT_TTL_SECONDS=1800

# Feature Flags
FEATURE_FLAG_CHAT_MULTI_AGENT=false
FEATURE_FLAG_CHAT_HANDOFF_ACCEPT=false
FEATURE_FLAG_CHAT_HANDOFF_ISSUE=false
