# Direct server-to-server NestJS backend URL.
# Keeps backend credentials and internal requests out of Client Components.
API_URL="http://127.0.0.1:3001"

# Public fallback URL for existing client boundaries.
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Agent Service URL (FastAPI Backend - Direct Stream)
NEXT_PUBLIC_AGENT_URL="http://localhost:3002"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_jwt_secret_must_match_backend"

# Stripe Public Key
NEXT_PUBLIC_STRIPE_PUBLIC_KEY="pk_test_..."

# Feature Flags
NEXT_PUBLIC_FEATURE_FLAG_CHECKOUT="true"
NEXT_PUBLIC_FEATURE_FLAG_BOOKING_READINESS="false"
NEXT_PUBLIC_FEATURE_FLAG_CHAT_MULTI_AGENT="false"
NEXT_PUBLIC_FEATURE_FLAG_CHAT_HANDOFF_ACCEPT="false"
