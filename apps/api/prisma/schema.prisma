datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum BookingIntentStatus {
  PENDING
  EXPIRED
  COMPLETED
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  status          UserStatus         @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  lastLogin       DateTime?
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]
  travelerProfile TravelerProfile?
  bookings        Booking[]
  bookingIntents  BookingIntent[]
  searchHistory   SearchHistory[]

  @@map("users")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  action        String
  resourceType  String
  resourceId    String?
  metadata      Json
  traceId       String
  correlationId String
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

enum MessageSender {
  USER
  AGENT
}

enum MessageType {
  STANDARD
  SUMMARY
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  title         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  lastActiveAt  DateTime      @default(now())
  messages      ChatMessage[]
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastActiveAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String        @id @default(uuid())
  sessionId   String
  sender      MessageSender
  type        MessageType   @default(STANDARD)
  content     String
  createdAt   DateTime      @default(now())
  session     ChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([sessionId, type])
  @@map("chat_messages")
}

/// TravelerProfile holds user travel preferences and sensitive travel identity documents.
/// All sensitive PII fields (like passportNumber and passportExpiry) are encrypted
/// at the application level using AES-256-GCM before storage to comply with GDPR requirements.
model TravelerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  seatPreference      String?
  classPreference     String?
  preferredAirlines   String[]
  blacklistedAirlines String[]
  dietaryNeeds        String?
  nationality         String?
  /// @encrypted
  /// Sensitive PII. Encrypted at the application layer using AES-256-GCM before database insertion.
  passportNumber      String?
  /// @encrypted
  /// Sensitive PII. Encrypted/tokenized at the application layer to comply with GDPR data protection requirements.
  passportExpiry      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingIntentPassengers BookingIntentPassenger[]

  @@map("traveler_profiles")
}

model Booking {
  id               String        @id @default(uuid())
  userId           String
  pnrCode          String?
  eTicketNumber    String?
  status           BookingStatus @default(PENDING)
  airline          String
  flightNumber     String
  origin           String        @db.VarChar(3)
  destination      String        @db.VarChar(3)
  departureTime    DateTime
  arrivalTime      DateTime
  duration         Int
  stops            Int           @default(0)
  fareClass        String?
  price            Decimal       @db.Decimal(10, 2)
  currency         String        @default("USD")
  passengers       Int           @default(1)
  baggageAllowance String?
  paymentReference String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("bookings")
}

model BookingIntent {
  id               String                @id @default(uuid())
  userId           String
  flightOfferId    String?
  duffelOfferId    String
  status           BookingIntentStatus   @default(PENDING)
  originalPrice    Decimal               @db.Decimal(10, 2)
  confirmedPrice   Decimal               @db.Decimal(10, 2)
  currency         String                @default("USD")
  priceChanged     Boolean               @default(false)
  pricedAt         DateTime
  origin           String                @db.VarChar(3)
  destination      String                @db.VarChar(3)
  departureDate    DateTime              @db.Date
  returnDate       DateTime?             @db.Date
  cabinClass       String                @default("economy")
  adults           Int
  children         Int                   @default(0)
  infants          Int                   @default(0)
  rawOfferSnapshot Json
  intentExpiresAt  DateTime
  offerExpiresAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  flightOffer      FlightOffer?          @relation(fields: [flightOfferId], references: [id], onDelete: SetNull)
  passengers       BookingIntentPassenger[]

  @@index([userId])
  @@index([userId, status])
  @@index([status, intentExpiresAt])
  @@index([status, updatedAt])
  @@map("booking_intents")
}

model BookingIntentPassenger {
  id                String           @id @default(uuid())
  intentId          String
  position          Int
  type              PassengerType
  givenName         String
  familyName        String
  dateOfBirth       DateTime         @db.Date
  gender            String
  nationality       String?          @db.VarChar(2)
  /// @encrypted
  passportNumber    String?
  /// @encrypted
  passportExpiry    String?
  travelerProfileId  String?
  createdAt         DateTime         @default(now())
  intent            BookingIntent    @relation(fields: [intentId], references: [id], onDelete: Cascade)
  travelerProfile   TravelerProfile? @relation(fields: [travelerProfileId], references: [id], onDelete: SetNull)

  @@index([intentId])
  @@index([travelerProfileId])
  @@unique([intentId, position])
  @@map("booking_intent_passengers")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum AirportType {
  LARGE_AIRPORT
  MEDIUM_AIRPORT
}

model Airport {
  id        String      @id @default(cuid())
  iataCode  String      @unique @db.VarChar(3)
  icaoCode  String?     @db.VarChar(4)
  name      String
  city      String
  country   String      @db.VarChar(2)
  region    String?
  latitude  Float
  longitude Float
  elevation Int?
  type      AirportType
  timezone  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([country])
  @@index([icaoCode])
  @@index([latitude, longitude])
  @@index([name])
  @@map("airports")
}

model FlightOffer {
  id              String   @id @default(uuid())
  searchHash      String
  duffelOfferId   String
  rawOffer        Json
  origin          String   @db.VarChar(3)
  destination     String   @db.VarChar(3)
  departureDate   DateTime @db.Date
  returnDate      DateTime? @db.Date
  adults          Int
  children        Int      @default(0)
  infants         Int      @default(0)
  cabinClass      String   @default("economy") @map("cabin_class")
  price           Decimal  @db.Decimal(10, 2)
  currency        String   @default("USD")
  createdAt       DateTime @default(now())
  bookingIntents  BookingIntent[]

  @@index([searchHash])
  @@index([createdAt])
  @@map("flight_offers")
}

model SearchHistory {
  id              String   @id @default(uuid())
  userId          String
  origin          String   @db.VarChar(3)
  destination     String   @db.VarChar(3)
  departureDate   DateTime @db.Date
  returnDate      DateTime? @db.Date
  adults          Int
  children        Int      @default(0)
  infants         Int      @default(0)
  cabinClass      String   @default("economy") @map("cabin_class")
  resultCount     Int
  minPrice        Decimal? @db.Decimal(10, 2)
  maxPrice        Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")
  searchHash      String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@map("search_history")
}

model OfferRecovery {
  id          String   @id // The offer UUID
  searchHash  String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("offer_recoveries")
}


