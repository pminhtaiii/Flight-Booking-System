# Server
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flight_booking?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Amadeus API
AMADEUS_API_KEY="your_amadeus_api_key"
AMADEUS_API_SECRET="your_amadeus_api_secret"

# Stripe - Use restricted API key (rk_test_...) for security
STRIPE_SECRET_KEY="rk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# AI Config (Mimo & LangChain)
MIMO_API_URL="https://api.mimo.example.com/v1"
MIMO_API_KEY="your_mimo_api_key"
LANGSMITH_API_KEY="your_langsmith_api_key"

# Auth
NEXTAUTH_SECRET="your_nextauth_jwt_secret_must_match_frontend"

# Duffel Webhooks
DUFFEL_WEBHOOK_SECRET="whsec_placeholder"

# Feature Flags - Disruption Management (false / true)
FEATURE_FLAG_DISRUPTION_INGRESS="false"
FEATURE_FLAG_DISRUPTION_PROCESSOR="false"
FEATURE_FLAG_DISRUPTION_RECONCILIATION="false"
FEATURE_FLAG_DISRUPTION_SURFACING="false"
FEATURE_FLAG_DISRUPTION_OUTBOX="false"
FEATURE_FLAG_BOOKING_READINESS="false"
PASSPORT_ADVISORY_BUFFER_DAYS=

# Chatbot Backend Infrastructure
FEATURE_FLAG_CHAT_HANDOFF_ACCEPT="false"
FEATURE_FLAG_CHAT_HANDOFF_ISSUE="false"
CHAT_ENCRYPTION_KEY="your_chat_encryption_key_32_bytes_base64"
CHAT_ATTESTATION_KEY="your_chat_attestation_key_32_bytes_base64"
CHAT_HANDOFF_CLAIM_TTL=600
