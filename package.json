{
  "name": "flight-booking-system-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @shared/types build",
    "build": "pnpm build:shared && pnpm --filter @api/backend build && pnpm --filter @web/frontend build",
    "dev": "pnpm --parallel dev",
    "test": "pnpm --recursive test",
    "test:smoke": "node --test --test-reporter=spec tests/smoke/smoke.test.mjs",
    "test:sanity": "node --test --test-reporter=spec tests/smoke/sanity.test.mjs",
    "test:smoke:units": "node --test tests/smoke/wait-for-ready.unit.test.mjs tests/smoke/mock-server.unit.test.mjs tests/smoke/test-utils.unit.test.mjs",
    "test:smoke:all": "node scripts/ci/run-smoke-sanity.mjs --mode=local",
    "lint": "eslint \"{apps,packages}/**/*.{ts,tsx}\" --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma",
    "seed": "npx tsx apps/api/prisma/seed.ts"
  }
}
